# Pusher Channels (used to refresh public CMS content in real time)
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# Supabase Storage. Keep the service-role key only in local/deployment secrets.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cms-assets
# This bucket must be private; it stores residents' service documents.
SUPABASE_SERVICE_ATTACHMENTS_BUCKET=service-attachments
# This bucket must be private; public archive downloads are authorized by the app.
SUPABASE_ARCHIVE_BUCKET=archive-documents

# Distributed rate limiting (required in production deployments with multiple instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Base64-encoded 32-byte key used to encrypt TOTP secrets at rest. Generate once
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# Cloudmersive Virus Scan API. Production uploads are rejected without this.
CLOUDMERSIVE_API_KEY= b97521fd-658f-4480-8ed5-3e7e9daea844
# Optional: use the default Cloudmersive advanced scan endpoint when blank.
CLOUDMERSIVE_API_URL=
