// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model QuickService {
  id      Int    @id @default(autoincrement())
  title   String
  icon    String
  bgColor String
  link    String
  order   Int    @default(0)
}

model News {
  id         Int      @id @default(autoincrement())
  title      String
  slug       String   @unique
  summary    String?
  content    String?
  category   String
  categoryBg String?
  image      String?
  isHeadline Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Document {
  id         Int      @id @default(autoincrement())
  title      String
  type       String
  size       String
  icon       String
  fileUrl    String?
  uploadedAt DateTime @default(now())
}

model Statistic {
  id    Int    @id @default(autoincrement())
  label String
  value String
  icon  String
  color String
  order Int    @default(0)
}

model CmsPageStore {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model CmsNewsStore {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model Complaint {
  id          String   @id @default(cuid())
  title       String
  category    String
  location    String
  contact     String
  description String
  status      String   @default("Baru")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model AdminUser {
  id           String         @id @default(cuid())
  username     String         @unique
  email        String         @unique
  passwordHash String
  name         String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PopulationOpeningBalance {
  id              String   @id @default(cuid())
  dusun           String   @unique
  effectiveDate   DateTime
  totalPopulation Int
  demographics    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PopulationEvent {
  id                 String              @id @default(cuid())
  eventDate          DateTime
  type               PopulationEventType
  dusun              String
  fullName           String
  nationalId         String
  familyCardNumber   String
  gender             String
  birthDate          DateTime
  residenceAddress   String
  originAddress      String?
  destinationAddress String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([eventDate, dusun, type])
  @@index([dusun, eventDate])
}

enum DisasterLocationType {
  EVAKUASI
  RAWAN
  POSKO
}

enum PopulationEventType {
  KELAHIRAN
  KEMATIAN
  PINDAH_MASUK
  PINDAH_KELUAR
}

model DisasterSetting {
  id           Int      @id @default(1)
  override     String   @default("auto")
  announcement String?
  updatedAt    DateTime @updatedAt
}

model DisasterLocation {
  id          String               @id @default(cuid())
  name        String
  description String?
  type        DisasterLocationType
  latitude    Float
  longitude   Float
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isActive, type])
}

model Umkm {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  category    String
  description String
  logoUrl     String
  whatsapp    String
  address     String?
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    UmkmProduct[]

  @@index([isPublished, category])
}

model UmkmProduct {
  id          String   @id @default(cuid())
  umkmId      String
  name        String
  description String
  imageUrl    String
  price       Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  umkm        Umkm     @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([umkmId, isAvailable])
}
