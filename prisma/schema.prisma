// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model QuickService {
  id      Int    @id @default(autoincrement())
  title   String
  icon    String
  bgColor String
  link    String
  order   Int    @default(0)
}

model News {
  id         Int      @id @default(autoincrement())
  title      String
  slug       String   @unique
  summary    String?
  content    String?
  category   String
  categoryBg String?
  image      String?
  isHeadline Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Document {
  id         Int      @id @default(autoincrement())
  title      String
  type       String
  size       String
  icon       String
  fileUrl    String?
  uploadedAt DateTime @default(now())
}

model Statistic {
  id    Int    @id @default(autoincrement())
  label String
  value String
  icon  String
  color String
  order Int    @default(0)
}

model CmsPageStore {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model CmsNewsStore {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model Complaint {
  id          String   @id @default(cuid())
  title       String
  category    String
  location    String
  contact     String
  description String
  status      String   @default("Baru")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model AdminUser {
  id           String         @id @default(cuid())
  username     String         @unique
  email        String         @unique
  passwordHash String
  name         String?
  role         AdminRole      @default(ADMIN)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  createdPosyanduSessions PosyanduSession[] @relation("PosyanduSessionCreator")
  recordedPosyanduChecks  PosyanduCheck[]   @relation("PosyanduCheckRecorder")
  serviceStatusUpdates    ServiceSubmissionStatus[] @relation("ServiceStatusUpdater")
}

model VillageService {
  id              String              @id @default(cuid())
  slug            String              @unique
  title           String
  description     String
  icon            String              @default("description")
  estimatedTime   String              @default("1-2 hari kerja")
  isActive        Boolean             @default(true)
  order           Int                 @default(0)
  requirements    ServiceRequirement[]
  submissions     ServiceSubmission[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([isActive, order])
}

model ServiceRequirement {
  id        String         @id @default(cuid())
  serviceId String
  title     String
  isRequired Boolean       @default(true)
  order     Int            @default(0)
  service   VillageService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, order])
}

model ServiceSubmission {
  id          String                    @id @default(cuid())
  trackingCode String                   @unique
  serviceId   String
  fullName    String
  nationalId  String
  address     String
  whatsapp    String
  purpose     String
  status      ServiceSubmissionStatusType @default(DIAJUKAN)
  service     VillageService            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  attachments ServiceAttachment[]
  history     ServiceSubmissionStatus[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([serviceId, status, createdAt])
  @@index([whatsapp, trackingCode])
}

model ServiceAttachment {
  id           String            @id @default(cuid())
  submissionId String
  requirementId String?
  filename     String
  mimeType     String
  size         Int
  storagePath  String
  createdAt    DateTime          @default(now())
  submission   ServiceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model ServiceSubmissionStatus {
  id           String                      @id @default(cuid())
  submissionId String
  status       ServiceSubmissionStatusType
  note         String?
  updatedById  String?
  createdAt    DateTime                    @default(now())
  submission   ServiceSubmission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  updatedBy    AdminUser?                  @relation("ServiceStatusUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Elderly {
  id          String           @id @default(cuid())
  fullName    String
  dusun       String
  birthDate   DateTime
  address     String
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  diseases    ElderlyDisease[]
  checks      PosyanduCheck[]

  @@index([isActive, dusun, fullName])
}

model ElderlyDisease {
  id             String   @id @default(cuid())
  elderlyId      String
  diseaseName    String
  normalizedName String
  startedAt      DateTime @default(now())
  endedAt        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  elderly        Elderly  @relation(fields: [elderlyId], references: [id], onDelete: Restrict)

  @@index([elderlyId, endedAt])
  @@index([endedAt, normalizedName])
}

model PosyanduSession {
  id          String          @id @default(cuid())
  name        String
  sessionDate DateTime
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   AdminUser       @relation("PosyanduSessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  checks      PosyanduCheck[]

  @@index([sessionDate])
}

model PosyanduCheck {
  id                  String          @id @default(cuid())
  sessionId           String
  elderlyId           String
  recordedById        String
  systolic            Int
  diastolic           Int
  weightKg            Float
  heightCm            Float
  bloodGlucoseMgDl    Float
  notes               String?
  recordedAt          DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  session             PosyanduSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  elderly             Elderly         @relation(fields: [elderlyId], references: [id], onDelete: Restrict)
  recordedBy          AdminUser       @relation("PosyanduCheckRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([sessionId, elderlyId])
  @@index([elderlyId, recordedAt])
  @@index([sessionId, recordedAt])
}

model PopulationOpeningBalance {
  id              String   @id @default(cuid())
  dusun           String   @unique
  effectiveDate   DateTime
  totalPopulation Int
  demographics    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PopulationEvent {
  id                 String              @id @default(cuid())
  eventDate          DateTime
  type               PopulationEventType
  dusun              String
  fullName           String
  nationalId         String
  familyCardNumber   String
  gender             String
  birthDate          DateTime
  residenceAddress   String
  originAddress      String?
  destinationAddress String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([eventDate, dusun, type])
  @@index([dusun, eventDate])
}

enum DisasterLocationType {
  EVAKUASI
  RAWAN
  POSKO
}

enum PopulationEventType {
  KELAHIRAN
  KEMATIAN
  PINDAH_MASUK
  PINDAH_KELUAR
}

enum AdminRole {
  ADMIN
  PETUGAS_PUSKESMAS
}

enum ServiceSubmissionStatusType {
  DIAJUKAN
  DIVERIFIKASI
  PERLU_DILENGKAPI
  DITOLAK
  SIAP_DIAMBIL
  SELESAI
}

model DisasterSetting {
  id           Int      @id @default(1)
  override     String   @default("auto")
  announcement String?
  updatedAt    DateTime @updatedAt
}

model DisasterLocation {
  id          String               @id @default(cuid())
  name        String
  description String?
  type        DisasterLocationType
  latitude    Float
  longitude   Float
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isActive, type])
}

model Umkm {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  category    String
  description String
  logoUrl     String
  whatsapp    String
  address     String?
  dusun       String        @default("Belum ditentukan")
  registeredAt DateTime      @default(now())
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    UmkmProduct[]

  @@index([isPublished, category])
  @@index([isPublished, dusun, registeredAt])
}

model UmkmProduct {
  id          String   @id @default(cuid())
  umkmId      String
  name        String
  description String
  imageUrl    String
  price       Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  umkm        Umkm     @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([umkmId, isAvailable])
}
