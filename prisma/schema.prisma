// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model QuickService {
  id      Int    @id @default(autoincrement())
  title   String
  icon    String
  bgColor String
  link    String
  order   Int    @default(0)
}

model News {
  id         Int      @id @default(autoincrement())
  title      String
  slug       String   @unique
  summary    String?
  content    String?
  category   String
  categoryBg String?
  image      String?
  isHeadline Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Document {
  id         Int      @id @default(autoincrement())
  title      String
  type       String
  size       String
  icon       String
  fileUrl    String?
  visibility DocumentVisibility @default(PUBLIC)
  originalName String?
  mimeType     String?
  byteSize     Int?
  storagePath  String?
  uploadedAt DateTime @default(now())

  @@index([visibility, uploadedAt])
}

model Statistic {
  id    Int    @id @default(autoincrement())
  label String
  value String
  icon  String
  color String
  order Int    @default(0)
}

model CmsPageStore {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model CmsNewsStore {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id                  Int      @id @default(1)
  villageName         String   @default("Desa Kedungrejo")
  district            String   @default("Kecamatan Modo")
  regency             String   @default("Kabupaten Lamongan")
  province            String   @default("Jawa Timur")
  officeAddress       String   @default("Jl. Raya Kedungrejo No. 01")
  phone               String   @default("")
  email               String   @default("")
  serviceHours        String   @default("")
  tagline             String   @default("Mewujudkan pelayanan publik yang terbuka, tanggap, dan dekat dengan warga.")
  instagramUrl        String?
  facebookUrl         String?
  youtubeUrl          String?
  siteTitle           String   @default("Desa Kedungrejo")
  siteDescription     String   @default("Website resmi Desa Kedungrejo")
  publicAnnouncement  String?
  maintenanceMode     Boolean  @default(false)
  maintenanceMessage  String   @default("Website sedang dalam pemeliharaan. Silakan kembali beberapa saat lagi.")
  siteUrl             String   @default("")
  seoKeywords         String[] @default([])
  seoImageUrl         String?
  allowIndexing       Boolean  @default(true)
  googleVerification  String?
  footerLinks         Json     @default("[]")
  updatedAt           DateTime @updatedAt
}

model SiteRedirect {
  id          String   @id @default(cuid())
  source      String   @unique
  destination String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Complaint {
  id          String   @id @default(cuid())
  title       String
  category    String
  location    String
  contact     String
  description String
  status      String   @default("Baru")
  publicResponse String?
  respondedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model AdminUser {
  id           String         @id @default(cuid())
  username     String         @unique
  email        String         @unique
  passwordHash String
  name         String?
  isSuperAdmin Boolean        @default(false)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  roles        AdminUserRole[]
  createdPosyanduSessions PosyanduSession[] @relation("PosyanduSessionCreator")
  recordedPosyanduChecks  PosyanduCheck[]   @relation("PosyanduCheckRecorder")
  createdChildPosyanduSessions ChildPosyanduSession[] @relation("ChildPosyanduSessionCreator")
  recordedChildChecks ChildHealthCheck[] @relation("ChildHealthCheckRecorder")
  serviceStatusUpdates    ServiceSubmissionStatus[] @relation("ServiceStatusUpdater")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       AdminUserRole[]
  permissions RolePermission[]
}

model AdminUserRole {
  userId String
  roleId String
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id        String    @id @default(cuid())
  roleId    String
  module    CmsModule
  canView   Boolean   @default(false)
  canCreate Boolean   @default(false)
  canUpdate Boolean   @default(false)
  canDelete Boolean   @default(false)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@index([module])
}

model VillageService {
  id              String              @id @default(cuid())
  slug            String              @unique
  title           String
  description     String
  icon            String              @default("description")
  estimatedTime   String              @default("1-2 hari kerja")
  isActive        Boolean             @default(true)
  order           Int                 @default(0)
  requirements    ServiceRequirement[]
  submissions     ServiceSubmission[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([isActive, order])
}

model ServiceRequirement {
  id        String         @id @default(cuid())
  serviceId String
  title     String
  isRequired Boolean       @default(true)
  order     Int            @default(0)
  service   VillageService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, order])
}

model ServiceSubmission {
  id          String                    @id @default(cuid())
  trackingCode String                   @unique
  serviceId   String
  fullName    String
  nationalId  String
  address     String
  whatsapp    String
  purpose     String
  status      ServiceSubmissionStatusType @default(DIAJUKAN)
  service     VillageService            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  attachments ServiceAttachment[]
  history     ServiceSubmissionStatus[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([serviceId, status, createdAt])
  @@index([whatsapp, trackingCode])
}

model ServiceAttachment {
  id           String            @id @default(cuid())
  submissionId String
  requirementId String?
  filename     String
  mimeType     String
  size         Int
  storagePath  String
  createdAt    DateTime          @default(now())
  submission   ServiceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model ServiceSubmissionStatus {
  id           String                      @id @default(cuid())
  submissionId String
  status       ServiceSubmissionStatusType
  note         String?
  updatedById  String?
  createdAt    DateTime                    @default(now())
  submission   ServiceSubmission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  updatedBy    AdminUser?                  @relation("ServiceStatusUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Elderly {
  id          String           @id @default(cuid())
  fullName    String
  dusun       String
  birthDate   DateTime
  address     String
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  diseases    ElderlyDisease[]
  checks      PosyanduCheck[]

  @@index([isActive, dusun, fullName])
}

model ElderlyDisease {
  id             String   @id @default(cuid())
  elderlyId      String
  diseaseName    String
  normalizedName String
  startedAt      DateTime @default(now())
  endedAt        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  elderly        Elderly  @relation(fields: [elderlyId], references: [id], onDelete: Restrict)

  @@index([elderlyId, endedAt])
  @@index([endedAt, normalizedName])
}

model PosyanduSession {
  id          String          @id @default(cuid())
  name        String
  sessionDate DateTime
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   AdminUser       @relation("PosyanduSessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  checks      PosyanduCheck[]

  @@index([sessionDate])
}

model PosyanduCheck {
  id                  String          @id @default(cuid())
  sessionId           String
  elderlyId           String
  recordedById        String
  systolic            Int
  diastolic           Int
  weightKg            Float
  heightCm            Float
  bloodGlucoseMgDl    Float
  notes               String?
  recordedAt          DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  session             PosyanduSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  elderly             Elderly         @relation(fields: [elderlyId], references: [id], onDelete: Restrict)
  recordedBy          AdminUser       @relation("PosyanduCheckRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([sessionId, elderlyId])
  @@index([elderlyId, recordedAt])
  @@index([sessionId, recordedAt])
}

model Child {
  id                    String             @id @default(cuid())
  fullName              String
  gender                String
  dusun                 String
  birthDate             DateTime
  address               String
  guardianName          String
  guardianPhone         String
  isActive              Boolean            @default(true)
  publicProfileConsent  Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  checks                ChildHealthCheck[]

  @@index([isActive, dusun, fullName])
}

model ChildPosyanduSession {
  id          String             @id @default(cuid())
  name        String
  sessionDate DateTime
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   AdminUser          @relation("ChildPosyanduSessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  checks      ChildHealthCheck[]

  @@index([sessionDate])
}

model ChildHealthCheck {
  id                  String               @id @default(cuid())
  sessionId           String
  childId             String
  recordedById        String
  weightKg            Float
  heightCm            Float
  headCircumferenceCm Float?
  feeding             String?
  interventions       String[]             @default([])
  developmentStatus   String?
  notes               String?
  referral            String?
  recordedAt          DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  session             ChildPosyanduSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  child               Child                @relation(fields: [childId], references: [id], onDelete: Restrict)
  recordedBy          AdminUser            @relation("ChildHealthCheckRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([sessionId, childId])
  @@index([childId, recordedAt])
  @@index([sessionId, recordedAt])
}

model PopulationOpeningBalance {
  id              String   @id @default(cuid())
  dusun           String   @unique
  effectiveDate   DateTime
  totalPopulation Int
  demographics    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Resident {
  id               String            @id @default(cuid())
  nationalId       String            @unique
  fullName         String
  familyCardNumber String
  gender           String
  birthDate        DateTime
  dusun            String
  education        String
  occupation       String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  events           PopulationEvent[]

  @@index([isActive, dusun])
  @@index([isActive, education])
  @@index([isActive, occupation])
  @@index([familyCardNumber])
}

model PopulationEvent {
  id                 String              @id @default(cuid())
  eventDate          DateTime
  type               PopulationEventType
  dusun              String
  fullName           String
  nationalId         String
  familyCardNumber   String
  gender             String
  birthDate          DateTime
  residenceAddress   String
  originAddress      String?
  destinationAddress String?
  notes              String?
  residentId         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  resident           Resident?           @relation(fields: [residentId], references: [id], onDelete: SetNull)

  @@index([eventDate, dusun, type])
  @@index([dusun, eventDate])
  @@index([residentId])
}

enum DisasterLocationType {
  EVAKUASI
  RAWAN
  POSKO
}

enum PopulationEventType {
  KELAHIRAN
  KEMATIAN
  PINDAH_MASUK
  PINDAH_KELUAR
}

enum CmsModule {
  DASHBOARD
  INFOGRAPHICS
  ELDERLY_HEALTH
  UMKM
  DISASTER_WEATHER
  PAGE_CONTENT
  NEWS
  DOCUMENT_ARCHIVE
  SERVICE_CATALOG
  SERVICE_SUBMISSIONS
  COMPLAINTS
  CMS_MODULES
  SETTINGS
}

enum DocumentVisibility {
  PUBLIC
  PRIVATE
}

enum ServiceSubmissionStatusType {
  DIAJUKAN
  DIVERIFIKASI
  PERLU_DILENGKAPI
  DITOLAK
  SIAP_DIAMBIL
  SELESAI
}

model DisasterSetting {
  id           Int      @id @default(1)
  override     String   @default("auto")
  announcement String?
  updatedAt    DateTime @updatedAt
}

model DisasterLocation {
  id          String               @id @default(cuid())
  name        String
  description String?
  type        DisasterLocationType
  latitude    Float
  longitude   Float
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isActive, type])
}

model Umkm {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  category    String
  description String
  logoUrl     String
  whatsapp    String
  address     String?
  dusun       String        @default("Belum ditentukan")
  registeredAt DateTime      @default(now())
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    UmkmProduct[]

  @@index([isPublished, category])
  @@index([isPublished, dusun, registeredAt])
}

model UmkmProduct {
  id          String   @id @default(cuid())
  umkmId      String
  name        String
  description String
  imageUrl    String
  price       Int
  variants    Json      @default("[]")
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  umkm        Umkm     @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([umkmId, isAvailable])
}
